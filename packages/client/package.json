{
  "name": "@spendctl/client",
  "version": "0.1.0",
  "description": "Zero-dependency client for the spendctl sidecar: a fetch wrapper for agents and an admin client for humans.",
  "keywords": [
    "spendctl",
    "x402",
    "mpp",
    "http-402",
    "ai-agents",
    "agent-payments",
    "spend-policy",
    "fetch"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miraistudio/spendctl-sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://spendctl.dev",
  "bugs": {
    "url": "https://github.com/miraistudio/spendctl-sdk/issues"
  }
}
