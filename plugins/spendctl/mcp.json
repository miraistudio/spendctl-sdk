{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spendctl": {
      "command": "npx",
      "args": ["-y", "spendctl@latest", "mcp"],
      "env": {
        "SPENDCTL_AGENT": "${SPENDCTL_AGENT}",
        "SPENDCTL_URL": "${SPENDCTL_URL}"
      }
    }
  }
}
